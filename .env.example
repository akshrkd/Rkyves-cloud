# Control plane database
DATABASE_URL=postgresql://rkyves:rkyves@localhost:5432/rkyves_control

# API
API_PORT=3001
API_PUBLIC_URL=https://api.rkyves.com
JWT_SECRET=change-me-in-production-use-long-random-string
ENCRYPTION_KEY=change-me-32-byte-hex-key-for-env-vars
CORS_ORIGIN=http://localhost:3000

# GitHub App (https://github.com/settings/apps)
GITHUB_APP_ID=
GITHUB_APP_SLUG=rkyves
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=change-me-github-webhook-secret

# Redis (job queue)
REDIS_URL=redis://localhost:6379

# Agent
AGENT_API_URL=http://localhost:3001
AGENT_TOKEN=agent-secret-token
WORKER_ID=worker-1

# Platform (production: CORS_ORIGIN=https://cloud.rkyves.com)
PLATFORM_DOMAIN=rkyves.com
ACME_EMAIL=admin@rkyves.com
HTTP_PORT=80
HTTPS_PORT=443

# MinIO
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=rkyves
MINIO_SECRET_KEY=rkyves-secret
MINIO_BUCKET_PREFIX=rkyves
