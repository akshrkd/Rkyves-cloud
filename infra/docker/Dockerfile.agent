FROM node:20-alpine AS base
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml .npmrc ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/docker-templates/package.json ./packages/docker-templates/
COPY packages/db/package.json ./packages/db/
COPY apps/api/package.json ./apps/api/
COPY apps/agent/package.json ./apps/agent/
COPY apps/dashboard/package.json ./apps/dashboard/
ENV CI=true
RUN pnpm install --frozen-lockfile

FROM base AS builder
COPY --from=deps /app ./
COPY tsconfig.base.json ./
COPY packages/shared ./packages/shared
COPY packages/docker-templates ./packages/docker-templates
COPY packages/db ./packages/db
COPY apps/agent ./apps/agent
RUN pnpm --filter @rkyves/shared build \
 && pnpm --filter @rkyves/docker-templates build \
 && pnpm --filter @rkyves/agent build

FROM base AS deploy
COPY --from=builder /app ./
RUN pnpm --filter @rkyves/agent deploy --prod /deploy/agent

FROM node:20-alpine AS runner
RUN apk add --no-cache git docker-cli
WORKDIR /app
ENV NODE_ENV=production
COPY --from=deploy /deploy/agent ./
CMD ["node", "dist/index.js"]
