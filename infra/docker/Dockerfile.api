FROM node:20-alpine AS base
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml .npmrc ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/docker-templates/package.json ./packages/docker-templates/
COPY packages/db/package.json ./packages/db/
COPY apps/api/package.json ./apps/api/
COPY apps/agent/package.json ./apps/agent/
COPY apps/dashboard/package.json ./apps/dashboard/
ENV CI=true
RUN pnpm install --frozen-lockfile

FROM base AS builder
COPY --from=deps /app ./
COPY tsconfig.base.json ./
COPY packages/shared ./packages/shared
COPY packages/db ./packages/db
COPY apps/api ./apps/api
RUN pnpm --filter @rkyves/shared build \
 && pnpm --filter @rkyves/db generate \
 && pnpm --filter @rkyves/db build \
 && pnpm --filter @rkyves/api build

FROM node:20-alpine AS runner
RUN apk add --no-cache curl openssl
WORKDIR /app
ENV NODE_ENV=production

# Keep full pnpm workspace layout so Node resolves all dependencies correctly
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/apps/api ./apps/api
COPY --from=builder /app/pnpm-workspace.yaml ./pnpm-workspace.yaml

COPY infra/docker/api-entrypoint.sh ./entrypoint.sh
RUN chmod +x ./entrypoint.sh
WORKDIR /app/apps/api
EXPOSE 3001
ENTRYPOINT ["/app/entrypoint.sh"]
